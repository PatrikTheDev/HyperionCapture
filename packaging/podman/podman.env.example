# Required: use an address reachable from the container. For a Hyperion server
# on another machine, its LAN hostname or address is normally sufficient.
HYPERION_URL=http://hyperion.local:8090/

HYPERION_TRANSPORT=flatbuffers
HYPERION_FLATBUFFER_PORT=19400
HYPERION_PRIORITY=150
HYPERION_FPS=20
HYPERION_OUTPUT_HEIGHT=480

# Keep this path in sync with AddDevice= in hyperion-capture.container.
HYPERION_DRM_DEVICE=/dev/dri/card0

# Optional: omit to select the first active connector.
# HYPERION_DRM_CONNECTOR=DP-1

# JSON image transport only. Keep this file mode 0600 if a token is present.
# HYPERION_TOKEN=replace-me
# HYPERION_JPEG_QUALITY=85

RUST_LOG=info
